{
	"name": "seidr",
	"version": "1.0.68",
	"private": true,
	"description": "Bondage Club cuddle / pull / undress activities \u2014 Seidr",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"bundle": "node tools/esbuild.mjs",
		"build": "npm run typecheck && SEIDR_SKIP_GIST=1 python3 tools/build-userscript.py",
		"publish:dev": "npm run typecheck && python3 tools/build-userscript.py",
		"publish:release": "npm run typecheck && python3 tools/publish-release.py",
		"sync:assets": "python3 tools/sync-assets.py",
		"test": "npm run bundle && node --test tests/*.test.js"
	},
	"devDependencies": {
		"bc-stubs": "^132.0.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.9.3"
	}
}
